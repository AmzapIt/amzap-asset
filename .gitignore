# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# local Codex chat backups
/.local-chat-backups/

# env files (can opt-in for committing if needed)
.env*
!.env.example

# Downloaded machine-specific configuration; keep outside commits.
/env.download
/.server-settings.json
/.server-settings.json.*.tmp

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# database backups (contain personal data)
/work/backups/
# work samples with employee data
/work/*.xlsx
/work/*.pdf
