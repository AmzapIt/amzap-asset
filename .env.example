# PostgreSQL connection string
DATABASE_URL=postgresql://USERNAME:PASSWORD@localhost:5432/DATABASE_NAME

# Required by auth.js and proxy.js for signing/encrypting login sessions.
# Fill in a random secret locally; never commit its real value.
AUTH_SECRET=

# Optional: 32 random bytes encoded as base64url. Required only when saving
# Product Keys in the License module. Keep the same value in every deployment.
LICENSE_ENCRYPTION_KEY=

# Optional explicit app URL. Local development currently detects the host.
# If set on another environment, use that environment's URL.
# AUTH_URL=http://localhost:3000

# Asset photos: keep google_drive for the existing Vercel deployment.
# Set to local only on the self-hosted test server. Choose an absolute folder
# outside this project, so copying/rebuilding the app never removes photos.
ASSET_PHOTO_STORAGE=google_drive
# ASSET_PHOTO_DIR=D:\AMZAP-Photos

# Google Drive OAuth (server-side only; never prefix these with NEXT_PUBLIC_)
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
GOOGLE_DRIVE_REFRESH_TOKEN=

# Optional: upload into this folder. Leave blank to upload to My Drive root.
GOOGLE_DRIVE_FOLDER_ID=
